# ═══════════════════════════════════════════════════════════════
#  Vodun Concept Store — .htaccess
#
#  Contenu volontairement limité au strict nécessaire : le fallback
#  React Router (BrowserRouter). C'est la configuration qui a été
#  validée en production sur cet hébergement.
#
#  ⚠️  Ne pas ajouter d'autres directives ici.
#      Les blocs de durcissement (Require, AddType, Expires, Header…)
#      exigent des droits Apache plus stricts (AllowOverride AuthConfig,
#      FileInfo) et provoquent une erreur 500 sur ce mutualisé.
#      La redirection www → sans www se règle dans Plesk
#      (Domains → vodunconceptstore.bj → SEO Settings → 301 redirect),
#      pas dans ce fichier, afin qu'un ré-upload ne puisse plus casser le site.
#
#  L'API n'a besoin d'aucune règle : le front appelle directement
#  /api/index.php (chemin réel), cf. src/api.js.
# ═══════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers et dossiers réels : servis normalement, jamais réécrits
  # (assets hashés, images WebP, /api/index.php, /sitemap.xml, /robots.txt…)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Garde-fou anti-boucle : une fois la réécriture vers index.html effectuée,
  # la condition échoue et le traitement s'arrête. Sans cette ligne, si
  # index.html est introuvable depuis la racine du DocumentRoot, Apache
  # réécrit en boucle et renvoie une erreur 500 au lieu d'un 404.
  RewriteCond %{REQUEST_URI} !^/index\.html$

  # Tout le reste → l'application React Router
  RewriteRule ^ index.html [L]
</IfModule>