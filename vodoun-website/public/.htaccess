# ═══════════════════════════════════════════════════════════════
#  Vodun Concept Store — .htaccess
#
#  ⚠️  L'ORDRE DES LIGNES EST IMPORTANT ET NE DOIT PAS ÊTRE MODIFIÉ.
#
#  RewriteRule ^index\.html$ - [L]  arrive AVANT les RewriteCond.
#  C'est cette règle qui stoppe le traitement quand la requête porte
#  déjà sur index.html. Sans elle, Apache réécrit /index.html vers
#  /index.html en boucle et finit en erreur 500.
#
#  Ce fichier est volontairement minimal : aucune directive de
#  durcissement (Require, AddType, Expires, Header…), car elles
#  exigent des droits Apache plus stricts et provoquent des 500
#  sur certains mutualisés.
#
#  L'API n'a besoin d'aucune règle : le front appelle directement
#  /api/index.php (chemin réel), cf. src/api.js.
#  La redirection www → sans www se règle dans Plesk, pas ici.
# ═══════════════════════════════════════════════════════════════

RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]