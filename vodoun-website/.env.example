# ── Vodun Concept Store — variables d'environnement ──────────────────────────
# Copier ce fichier vers .env (local) ou renseigner ces variables
# dans Plesk → Node.js → Variables d'environnement (production).

# ── Connexion MariaDB (Plesk : onglet Bases de données → infos d'accès) ─────
# Option A (recommandée) : chaîne de connexion complète
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=mysql://voduncon_admin:motdepasse@localhost:3306/voduncon_bdd

# Option B : variables séparées (utilisées si DATABASE_URL absent)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=voduncon_admin
# DB_PASSWORD=motdepasse
# DB_NAME=voduncon_bdd

# ── Administration ───────────────────────────────────────────────────────────
# Identifiant du compte admin du panneau (/admin). Défaut : admin
ADMIN_USER=admin
# Mot de passe de ce compte. S'il n'est pas fourni au premier démarrage,
# un mot de passe aléatoire est généré et affiché une fois dans les logs.
ADMIN_PASSWORD=changez-moi

# ── Serveur HTTP ─────────────────────────────────────────────────────────────
# Port d'écoute (Plesk définit souvent son propre port dans « App entry point » ;
# laisser 3000 pour un lancement local).
PORT=3000
HOST=0.0.0.0

# Origine(s) autorisée(s) par CORS. Défaut : * (toutes)
# Exemple : https://vodunconceptstore.bj
CORS_ORIGIN=*